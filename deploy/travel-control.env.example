# Copy to /opt/travel-control/travel-control.env and chmod 600.
# Keep APP_HOSTNAME and TRAVELCONTROL_HOST_PORT equal to the GitHub
# Environment variables with the same names.

APP_HOSTNAME=CHANGE_ME
TRAVELCONTROL_HOST_PORT=CHANGE_ME
BootstrapImport__Enabled=true
BootstrapImport__Required=true
Storage__MaxBytes=10485760
PublicRead__Enabled=true
PublicRead__NameMode=Full
