{
  "ConnectionStrings": {
    "Database": "Data Source=/var/lib/travel-control/data/travel-control.db"
  },
  "Security": {
    "CookieSecure": true,
    "DataProtectionKeys": "/var/lib/travel-control/keys"
  },
  "Storage": {
    "Root": "/var/lib/travel-control/attachments",
    "MaxBytes": 10485760
  },
  "BootstrapImport": {
    "Enabled": false,
    "Required": false,
    "MasterWorkbookPath": "/var/lib/travel-control/private/Control_viaje.xlsx"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
