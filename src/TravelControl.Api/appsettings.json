{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=travel_control;Username=travel;Password=change-me"
  },
  "Security": {
    "AllowedOrigins": [ "https://localhost:5173" ]
  },
  "Storage": {
    "Root": "attachments",
    "MaxBytes": 10485760
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}

